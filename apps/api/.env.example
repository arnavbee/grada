APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# SQLite for quick local dev; use Postgres for anything real.
DATABASE_URL=sqlite:///./kira.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kira

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_REFRESH_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
SESSION_TIMEOUT_HOURS=24

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPER_ADMIN_EMAILS=owner@example.com

# AI extraction. Leave blank to run with AI features disabled.
# Works with OpenAI, OpenRouter (sk-or-*), or any OpenAI-compatible endpoint.
OPENAI_API_KEY=
AI_MODEL=gpt-4o
# AI_BASE_URL=https://openrouter.ai/api/v1

# S3-compatible object storage (Cloudflare R2 recommended — free tier, no egress fees).
# REQUIRED in production unless ALLOW_EPHEMERAL_STORAGE=true.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_REGION=auto
# ALLOW_EPHEMERAL_STORAGE=false

RATE_LIMIT_ENABLED=true
JOB_WORKER_ENABLED=true
